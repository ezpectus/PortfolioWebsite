---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg
  viewBox="0 0 46 26"
  class="h-6 w-11"
  aria-hidden="true"
  fill="none"
  stroke="#141414"
  stroke-width="1"
>
  {
    name === "hft" && (
      <polyline points="2,19 8,15 13,17 19,9 25,12 31,5 37,8 44,3" stroke="#141414" />
    )
  }
  {
    name === "logs" && (
      <g>
        <rect x="3" y="4" width="36" height="4" />
        <rect x="9" y="11" width="24" height="4" />
        <rect x="15" y="18" width="12" height="4" stroke="#e8480c" />
      </g>
    )
  }
  {
    name === "sorting" && (
      <g fill="#141414" stroke="none">
        <rect x="4" y="14" width="5" height="9" />
        <rect x="12" y="10" width="5" height="13" />
        <rect x="20" y="16" width="5" height="7" />
        <rect x="28" y="6" width="5" height="17" fill="#e8480c" />
        <rect x="36" y="12" width="5" height="11" />
      </g>
    )
  }
  {
    name === "http206" && (
      <g>
        <rect x="2" y="10" width="42" height="8" />
        <line x1="9" y1="10" x2="9" y2="18" />
        <line x1="16" y1="10" x2="16" y2="18" />
        <line x1="23" y1="10" x2="23" y2="18" />
        <line x1="30" y1="10" x2="30" y2="18" />
        <line x1="37" y1="10" x2="37" y2="18" />
        <rect x="23" y="11" width="6" height="6" fill="#e8480c" stroke="none" />
      </g>
    )
  }
  {
    name === "yamlgraph" && (
      <g>
        <rect x="3" y="4" width="14" height="9" />
        <rect x="28" y="13" width="14" height="9" />
        <line x1="17" y1="9" x2="28" y2="16" />
        <path d="M 25 13 L 28 16 L 24 17" />
      </g>
    )
  }
  {
    name === "forge" && (
      <g>
        <line x1="3" y1="13" x2="30" y2="13" />
        <path d="M 26 9 L 31 13 L 26 17" />
        <rect x="33" y="7" width="11" height="12" stroke="#e8480c" />
      </g>
    )
  }
  {
    name === "guarddog" && (
      <g>
        <rect x="6" y="3" width="34" height="4" />
        <rect x="12" y="10" width="22" height="4" />
        <rect x="18" y="17" width="10" height="4" />
        <rect x="30" y="17" width="10" height="4" stroke="#e8480c" />
      </g>
    )
  }
</svg>

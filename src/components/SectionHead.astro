---
interface Props {
  num: string;
  label: string;
  title?: string;
  id?: string;
}
const { num, label, title, id } = Astro.props;
---

<div id={id} class="scroll-mt-8 border-t border-line pt-5">
  <p class="mono"><span class="text-accent-deep">{num}</span> / {label}</p>
  {
    title && (
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink">{title}</h2>
    )
  }
</div>

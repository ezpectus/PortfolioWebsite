---
// Static snapshot as fallback (pulled from the GitHub commits API on 2026-11-13);
// each row is refreshed live at build time when the API answers.
// index 0 = Jul 2025 … index 16 = Nov 2026
import { getCommitWindow, monthIndex } from "../utils/github";

const MONTHS = [
  "J",
  "A",
  "S",
  "O",
  "N",
  "D",
  "J",
  "F",
  "M",
  "A",
  "M",
  "J",
  "J",
  "A",
  "S",
  "O",
  "N",
];
const LAST = MONTHS.length - 1;
const clamp = (i: number) => Math.min(Math.max(i, 0), LAST);

const staticRows = [
  { label: "leetcode-solutions", repo: "LeetCode-solutions", s: 0, e: 13, c: "1,616" },
  { label: "algorithm-patterns", repo: "Algorithm-patterns", s: 1, e: 12, c: "286" },
  { label: "taskmanager", repo: "TaskManager_App", s: 6, e: 11, c: "54" },
  { label: "videohub", repo: "VideoHub", s: 8, e: 10, c: "76" },
  { label: "log-observability", repo: "AI-Log-Observability-MVP", s: 10, e: 11, c: "24" },
  { label: "hft-simulator", repo: "HFT-trading-simulator", s: 11, e: 14, c: "1,289" },
  { label: "algo-visualiser", repo: "algo-visualiser", s: 12, e: 12, c: "3" },
  { label: "student-portal", repo: "student-portal", s: 12, e: 13, c: "58" },
  { label: "fullstack-portfolio", repo: "fullstack-portfolio", s: 13, e: 13, c: "89" },
  { label: "forgeai", repo: "forgeai", s: 14, e: 14, c: "215" },
  { label: "guarddog", repo: "GuardDOG", s: 15, e: 15, c: "13" },
  { label: "webhook-engine", repo: "webhook-engine", s: 15, e: 16, c: "134" },
  { label: "collabcanvas", repo: "collabcanvas", s: 16, e: 16, c: "150" },
];

const rows = await Promise.all(
  staticRows.map(async (r) => {
    const w = await getCommitWindow(r.repo);
    if (!w) return { label: r.label, s: r.s, e: r.e, c: r.c };
    return {
      label: r.label,
      s: clamp(monthIndex(w.first)),
      e: clamp(monthIndex(w.last)),
      c: w.count.toLocaleString("en-GB"),
    };
  }),
);
rows.sort((a, b) => a.s - b.s || b.e - a.e);
const X0 = 200;
const X1 = 700;
const M = (X1 - X0) / 17;
const bx = (m: number) => X0 + m * M;
const y = (i: number) => 40 + i * 23;
const top = 28;
const bottom = y(rows.length - 1) + 10;
---

<figure class="border border-line p-5 sm:p-8">
  <div class="dgm-scroll">
    <svg
      viewBox="0 0 760 362"
      class="h-auto w-full"
      role="img"
      aria-label="Commit activity windows per project, July 2025 to November 2026, drawn from the GitHub commits API"
    >
      <!-- month grid -->
      {
        MONTHS.map((m, i) => (
          <g>
            <line x1={bx(i)} y1={top} x2={bx(i)} y2={bottom + 14} class="dgm-line" />
            <text x={bx(i) + M / 2} y={bottom + 32} text-anchor="middle" class="dgm-sm">
              {m}
            </text>
          </g>
        ))
      }
      <line x1={X1} y1={top} x2={X1} y2={bottom + 14} class="dgm-line"></line>

      <!-- year markers -->
      <text x={bx(0) + 2} y={top - 8} class="dgm-sm dgm-ink">2025</text>
      <text x={bx(6) + 2} y={top - 8} class="dgm-sm dgm-ink">2026</text>

      {
        rows.map((r, i) => (
          <g>
            <text x={X0 - 12} y={y(i) + 3} text-anchor="end" class="dgm-sm">
              {r.label}
            </text>
            <rect
              x={bx(r.s)}
              y={y(i) - 4}
              width={Math.max((r.e - r.s + 1) * M, 4)}
              height="8"
              class={r.label === "hft-simulator" ? "dgm-fill-acc" : "dgm-fill-ink"}
            />
            <text x={bx(r.e) + Math.max((r.e - r.s + 1) * M, 4) + 7} y={y(i) + 3} class="dgm-sm">
              {r.c}
            </text>
          </g>
        ))
      }
    </svg>
  </div>
  <figcaption class="mono mt-4">
    Commit windows per repo — first to last commit, GitHub API · Nov 2026
  </figcaption>
</figure>

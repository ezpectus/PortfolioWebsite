---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import WorkTable from "../../components/WorkTable.astro";
import site from "../../data/site.json";
import { u } from "../../utils/url";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.map((p) => ({
  name: p.data.title,
  year: p.data.year,
  stack: p.data.stack.slice(0, 3).join(" · "),
  metric: p.data.metric,
  href: u(`work/${p.id}/`),
  glyph: p.data.diagram,
}));

const archive = site.archive.map((r) => ({
  name: r.name,
  year: r.year,
  stack: r.stack,
  note: r.note,
  href: r.repo,
  external: true,
}));
---

<BaseLayout
  title="Project index — Denys Stepanenko"
  description="Full index of public work: flagship case studies, tools, archives and coursework."
>
  <div class="mx-auto max-w-[1120px] px-5 pt-14">
    <p class="mono"><a href={u("/")} class="hover:text-ink">← Index</a> / Project index</p>
    <h1 class="mt-6 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      All work
    </h1>
    <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-muted">
      Flagships have full case studies; the rest are indexed straight to GitHub. Everything below is
      public and auditable.
    </p>

    <div class="pt-12">
      <SectionHead num="01" label="Case studies" />
      <div class="mt-8">
        <WorkTable rows={featured} numbered />
      </div>
    </div>

    <div class="pb-24 pt-16">
      <SectionHead num="02" label="Archive" />
      <div class="mt-8">
        <WorkTable rows={archive} numbered />
      </div>
    </div>
  </div>
</BaseLayout>
